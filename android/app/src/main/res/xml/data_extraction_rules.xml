<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the API token out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
