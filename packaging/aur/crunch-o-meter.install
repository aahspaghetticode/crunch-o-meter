post_install() {
  cat <<'MSG'

Crunch-o-meter server installed. To set it up:

  mkdir -p ~/.config/crunch-o-meter
  cp /usr/share/doc/crunch-o-meter/config.example.toml ~/.config/crunch-o-meter/config.toml
  crunch-o-meter gen-token        # paste into token = "..." in that file
  crunch-o-meter check            # shows what works and what to fix
  systemctl --user enable --now crunch-o-meter
  sudo tailscale serve --bg 8765  # then enter the address and token in the app

Full guide: /usr/share/doc/crunch-o-meter/README.md

MSG
}

post_upgrade() {
  echo "Restart the server to use the new version: systemctl --user restart crunch-o-meter"
}
